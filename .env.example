# AWS
AWS_REGION=us-east-1

# DynamoDB / S3 (optional — defaults match current dev setup)
# CAREERPILOT_JOBS_TABLE=careerpilotai_db
# CAREERPILOT_S3_BUCKET=careerpilotai

# Bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Resume + RAG
RESUME_FILENAME=Justin_Traille.docx
TAILORED_RESUME_FILENAME_PREFIX=Justin_Traille
CAREERPILOT_TIMEZONE=America/New_York
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=resume-knowledge

# Admin Google OAuth SSO (demo mode when set)
# Comma-separated allowlist — only these Google accounts become admin.
ADMIN_EMAILS=you@gmail.com
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://127.0.0.1:5173
# Must be added as an Authorized redirect URI in Google Cloud Console
# (Web client preferred; can reuse desktop client secrets if you add this URI).
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/api/admin/auth/callback
# Optional — defaults to credentials.json client_id/secret
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_SECRETS=credentials.json

# Frontend production build (GitHub Actions variable, not committed):
# VITE_API_BASE_URL=https://careerpilot-ai-alb-....elb.amazonaws.com
# ECS task env should set:
# FRONTEND_URL=https://jobs.ablackcloudapp.com
# GOOGLE_OAUTH_REDIRECT_URI=https://<api-host>/api/admin/auth/callback
